# Generate with: openssl rand -hex 32
API_TOKEN=replace-me-with-32-bytes-of-hex
# Optional: a token that can list/download but not write or delete.
API_TOKEN_READONLY=

# uid:gid the containers run as (docker-compose.yml only). Files written to
# the shared folder are owned by this, and the folder must be writable by it.
# unRAID: PUID=99, PGID=100 (nobody:users).
PUID=1000
PGID=1000

# Public URL clients reach this service at, through your reverse proxy or
# tunnel. Used for the one-time upload/download links; see README.md.
PUBLIC_BASE_URL=

# -- Optional MCP connector (see README.md, "MCP connector") ----------------
# Mount /mcp so this service can be added once as a claude.ai / Cowork custom
# connector. true by default -- set false to turn it off without rebuilding.
ENABLE_MCP=true
# This service's public hostname (e.g. files.example.com), used only to
# allow-list the Host header the MCP SDK's DNS-rebinding guard checks. Leave
# blank to disable that guard rather than have it 421 every request through
# your reverse proxy or tunnel; /mcp is still gated by API_TOKEN either way.
MCP_PUBLIC_HOSTNAME=
# read_file's inline text budget, in characters. A file over this is
# returned as a preview + truncation note pointing at the REST endpoint.
MCP_INLINE_LIMIT_CHARS=100000
# read_file/write_file's single-shot cap on source bytes when
# encoding="base64", in bytes. This is advisory -- the real ceiling is
# whatever a caller can emit in one tool call, which the server can't see.
# Over this cap, write_file refuses and names begin_write/write_chunk/
# commit_write for a file that size instead.
MCP_BASE64_LIMIT_BYTES=8192
# Idle timeout (seconds) for a begin_write chunked-upload session before it
# is reaped -- lazily, on the next begin_write/write_chunk call, not by a
# background task.
MCP_UPLOAD_SESSION_TTL_SECONDS=900
# Cap on open chunked-upload sessions at once. begin_write refuses beyond
# this and names abort_write.
MCP_MAX_CONCURRENT_UPLOADS=8
# Suggested chunk size (bytes) for write_chunk, reported by begin_write and
# get_folder_info. Advisory only -- not enforced.
MCP_UPLOAD_CHUNK_ADVISORY_BYTES=3072

# -- Local upload/download bridge (see README.md, "Uploading binary files:
# the local bridge", and bridge/README.md) -----------------------------
# The bridge's own CLAUDE_FILES_URL / CLAUDE_FILES_TOKEN[_FILE] /
# CLAUDE_FILES_TIMEOUT are NOT server settings and do not belong here --
# they're read by bridge/claude_files_bridge.py wherever an agent runs it,
# which is never this container.

# -- Extension modules (docs/extensions.md) ----------------------------------
# Comma-separated Python modules that add tools to /mcp at startup. Normally
# set by a derived image's Dockerfile (ENV EXTRA_TOOL_MODULES=...), not here.
# A module that fails to load stops the server from starting.
EXTRA_TOOL_MODULES=

# -- Autocommit sidecar (see README.md, "Auto-committing what agents write") --
# Set true ONLY if the autocommit service in docker-compose.yml (or something
# else) commits and pushes this folder. The MCP connector then tells agents
# their writes are committed and pushed automatically; left false, it makes no
# claim about git at all. This changes only what agents are told: it commits
# nothing. Ignored when ENABLE_GIT_WRITE=true, where agents commit themselves.
AUTOCOMMIT_NOTICE=false

# -- Optional git tools (docs/plan-mcp-git-ops.md) ---------------------------
# Two independent switches. A disabled class is not registered at all, so its
# tools are absent from the MCP tool list rather than present and refusing.
#   ENABLE_GIT_READ   git_status, git_log, git_diff   (works with the read-only token)
#   ENABLE_GIT_WRITE  git_commit, git_pull, git_push, git_merge, git_fetch
#                     (needs the read-write token)
# Nothing is committed or pushed automatically: the agent drives every git
# operation. Needs an image built with WITH_GIT=1 (the default).
ENABLE_GIT_READ=false
ENABLE_GIT_WRITE=false
# Where the repository ROOT is mounted. Leave unset when DATA_ROOT is itself
# the repository root; set it (e.g. /repo) when DATA_ROOT is a subfolder, which
# becomes the agent's scope: it may read git status for the whole repo, but
# every write is refused if it would touch anything outside that folder.
GIT_REPO_ROOT=
# The only remote ever fetched from or pushed to, and the only branch ever
# committed to or pushed. Empty branch = whatever is checked out at startup.
GIT_REMOTE=origin
GIT_BRANCH=
GIT_AUTHOR_NAME=claude-files agent
GIT_AUTHOR_EMAIL=agent@localhost
# Optional trailer appended to every commit message, e.g. "Committed-Via: claude-files".
GIT_COMMIT_TRAILER=
# git_commit refuses to commit more files than this (runaway guard). 0 disables.
GIT_MAX_CHANGED_FILES=1000
GIT_NETWORK_TIMEOUT_SECONDS=60
GIT_LOCAL_TIMEOUT_SECONDS=30
# Let git_pull / git_merge bring REMOTE content into files outside the shared
# folder. Off by default. Needs GIT_REPO_ROOT mounted read-write. The agent can
# never AUTHOR a change outside its folder either way.
GIT_PULL_OUTSIDE_SCOPE=false
# Credentials for the remote -- same names as the autocommit sidecar. Mount the
# key read-only outside the repository. SSH_KNOWN_HOSTS_PATH is REQUIRED with a
# key: this container never trusts a host key on first use.
SSH_KEY_PATH=
SSH_KNOWN_HOSTS_PATH=
GIT_TOKEN=
