# Generate with: openssl rand -hex 32
API_TOKEN=replace-me-with-32-bytes-of-hex
# Optional: a token that can list/download but not write or delete.
API_TOKEN_READONLY=

# -- Optional MCP connector (see README.md, "MCP connector") ----------------
# Mount /mcp so this service can be added once as a claude.ai / Cowork custom
# connector. true by default -- set false to turn it off without rebuilding.
ENABLE_MCP=true
# This service's public hostname (e.g. claude-files.example.dev), used only
# to allow-list the Host header the MCP SDK's DNS-rebinding guard checks.
# Leave blank to disable that guard rather than have it 421 every request
# through the tunnel; /mcp is still gated by API_TOKEN either way.
MCP_PUBLIC_HOSTNAME=
# read_file's inline text budget, in characters. A file over this is
# returned as a preview + truncation note pointing at the REST endpoint.
MCP_INLINE_LIMIT_CHARS=100000
# read_file/write_file's cap on source bytes when encoding="base64", in
# bytes. Kept far below the text budget -- base64 inflates by 33% and is
# unreadable to the model, so this exists only for small binary files.
MCP_BASE64_LIMIT_BYTES=1048576
